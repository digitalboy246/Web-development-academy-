@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg: #f4f7fb;
    --card: #ffffff;
    --text: #111827;
    --muted: #6b7280;
    --border: #e5e7eb;

    --primary: #2563eb;
    --primary-dark: #1d4ed8;

    --green: #16a34a;
    --purple: #7c3aed;

    --sidebar: #07111f;
}

body {
    font-family: "DM Sans", sans-serif;
    background: var(--bg);
    color: var(--text);
    transition: .3s;
}

button {
    font-family: inherit;
    border: none;
    cursor: pointer;
}

.app {
    min-height: 100vh;
}


/* SIDEBAR */

.sidebar {
    width: 250px;
    height: 100vh;
    position: fixed;
    left: 0;
    top: 0;
    background: var(--sidebar);
    color: white;
    padding: 25px 16px;
    display: flex;
    flex-direction: column;
    z-index: 1000;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    margin-bottom: 35px;
}

.logo-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--primary);
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 20px;
}

.logo h2 {
    font-family: "Manrope";
    font-size: 18px;
}

.logo span {
    font-size: 9px;
    letter-spacing: 3px;
    color: #94a3b8;
}

nav {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.nav-link {
    width: 100%;
    background: transparent;
    color: #94a3b8;
    padding: 13px 15px;
    border-radius: 10px;
    text-align: left;
    display: flex;
    align-items: center;
    gap: 13px;
    font-size: 14px;
    transition: .2s;
}

.nav-link:hover,
.nav-link.active {
    background: rgba(255,255,255,.08);
    color: white;
}

.nav-link.active {
    border-left: 3px solid var(--primary);
}

.sidebar-bottom {
    margin-top: auto;
}


/* MAIN */

.main {
    margin-left: 250px;
    min-height: 100vh;
}


/* TOPBAR */

.topbar {
    height: 80px;
    background: var(--card);
    border-bottom: 1px solid var(--border);
    padding: 0 35px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.top-title h1 {
    font-family: "Manrope";
    font-size: 22px;
}

.top-title p {
    color: var(--muted);
    font-size: 12px;
    margin-top: 3px;
}

.top-actions {
    display: flex;
    align-items: center;
    gap: 20px;
}

.icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg);
    font-size: 17px;
}

.profile {
    display: flex;
    align-items: center;
    gap: 10px;
}

.avatar {
    width: 40px;
    height: 40px;
    background: var(--primary);
    color: white;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 700;
}

.profile-info {
    display: flex;
    flex-direction: column;
}

.profile-info small {
    color: var(--muted);
    font-size: 11px;
}

.menu-btn {
    display: none;
    background: transparent;
    font-size: 22px;
}


/* PAGES */

.page {
    padding: 35px;
    display: none;
}

.active-page {
    display: block;
}


/* WELCOME */

.welcome-card {
    background: linear-gradient(120deg, #0b1d35, #123e78);
    color: white;
    border-radius: 22px;
    padding: 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    overflow: hidden;
    position: relative;
}

.small-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #64748b;
}

.welcome-card .small-label {
    color: #93c5fd;
}

.welcome-card h2 {
    font-family: "Manrope";
    font-size: clamp(25px, 3vw, 38px);
    line-height: 1.15;
    margin: 10px 0;
}

.welcome-card p {
    color: #cbd5e1;
    max-width: 540px;
    line-height: 1.6;
    margin-bottom: 25px;
}

.welcome-code {
    width: 180px;
    height: 180px;
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 60px;
    color: #60a5fa;
    background: rgba(255,255,255,.05);
}


/* BUTTONS */

.primary-btn {
    background: var(--primary);
    color: white;
    padding: 12px 19px;
    border-radius: 9px;
    font-weight: 700;
    transition: .2s;
}

.primary-btn:hover {
    background: var(--primary-dark);
    transform: translateY(-1px);
}

.secondary-btn {
    background: var(--bg);
    color: var(--text);
    padding: 12px 17px;
    border-radius: 9px;
    font-weight: 600;
}

.text-btn {
    color: var(--primary);
    background: transparent;
    font-weight: 700;
    margin-top: 10px;
}


/* STATS */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 15px;
    margin: 20px 0;
}

.stat-card {
    background: var(--card);
    border: 1px solid var(--border);
    padding: 20px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    gap: 15px;
}

.stat-icon {
    width: 43px;
    height: 43px;
    border-radius: 11px;
    background: var(--bg);
    display: grid;
    place-items: center;
    font-size: 20px;
}

.stat-card strong {
    font-size: 22px;
}

.stat-card p {
    color: var(--muted);
    font-size: 12px;
}


/* GRID */

.dashboard-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 25px;
    margin-bottom: 20px;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

.section-heading h2 {
    font-family: "Manrope";
    font-size: 19px;
    margin-top: 4px;
}

.section-heading p {
    color: var(--muted);
    font-size: 12px;
    margin-top: 4px;
}

.overall-number {
    color: var(--primary);
    font-size: 25px;
}


/* PROGRESS */

.progress-item {
    margin-bottom: 20px;
}

.progress-label {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 13px;
}

.progress-label strong {
    color: var(--muted);
}

.progress-bar {
    width: 100%;
    height: 8px;
    border-radius: 20px;
    background: #e5e7eb;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    border-radius: inherit;
}

.html-fill {
    background: #f97316;
}

.css-fill {
    background: #2563eb;
}

.js-fill {
    background: #eab308;
}


/* TEACHER */

.teacher-content {
    display: flex;
    gap: 17px;
    align-items: center;
    margin-top: 15px;
}

.teacher-avatar {
    width: 65px;
    height: 65px;
    border-radius: 18px;
    background: #eef2ff;
    display: grid;
    place-items: center;
    font-size: 30px;
}

.teacher-content h2 {
    font-size: 18px;
    margin-bottom: 6px;
}

.teacher-content p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
}


/* LESSON */

.lesson-row {
    display: flex;
    align-items: center;
    gap: 17px;
}

.lesson-icon {
    width: 58px;
    height: 58px;
    border-radius: 14px;
    background: #eff6ff;
    color: var(--primary);
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 19px;
}

.lesson-info {
    flex: 1;
}

.lesson-info h3 {
    margin-bottom: 5px;
}

.lesson-info p {
    color: var(--muted);
    font-size: 12px;
}

.lesson-number {
    color: var(--muted);
    font-size: 12px;
}


/* PATH */

.learning-path {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.path {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px;
    border-radius: 12px;
    background: var(--bg);
}

.path-number {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: white;
    font-weight: 700;
}

.path.active .path-number {
    background: var(--green);
    color: white;
}

.path div:nth-child(2) {
    flex: 1;
}

.path h3 {
    font-size: 14px;
}

.path p {
    color: var(--muted);
    font-size: 11px;
    margin-top: 3px;
}

.path > span {
    color: var(--muted);
    font-size: 12px;
}


/* PAGE HEADER */

.page-header {
    margin-bottom: 25px;
}

.page-header h2 {
    font-family: "Manrope";
    font-size: 30px;
    margin: 7px 0;
}

.page-header p {
    color: var(--muted);
}


/* COURSES */

.course-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 20px;
}

.course-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 25px;
}

.course-icon {
    width: 55px;
    height: 55px;
    border-radius: 14px;
    background: var(--bg);
    display: grid;
    place-items: center;
    font-size: 24px;
    margin-bottom: 18px;
}

.html-icon {
    color: #f97316;
}

.course-status {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: var(--green);
}

.course-card h3 {
    margin: 9px 0;
    font-family: "Manrope";
}

.course-card p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
    margin-bottom: 20px;
}

.course-progress {
    margin-bottom: 20px;
}

.course-progress > div:first-child {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    margin-bottom: 8px;
}


/* CODE EDITOR */

.code-editor-card {
    background: #08111e;
    border-radius: 18px;
    overflow: hidden;
}

.editor-top {
    background: #111c2d;
    padding: 13px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: white;
}

.editor-top button {
    background: var(--green);
    color: white;
    padding: 7px 15px;
    border-radius: 6px;
}

.dots {
    display: flex;
    gap: 5px;
}

.dots span {
    width: 10px;
    height: 10px;
    background: #64748b;
    border-radius: 50%;
}

#codeEditor {
    width: 100%;
    height: 230px;
    resize: vertical;
    background: #08111e;
    color: #dbeafe;
    border: none;
    outline: none;
    padding: 20px;
    font-family: monospace;
    font-size: 14px;
}

.preview-title {
    color: #94a3b8;
    padding: 12px 18px;
    background: #111c2d;
    font-size: 11px;
    letter-spacing: 1px;
}

#preview {
    width: 100%;
    height: 250px;
    border: none;
    background: white;
}


/* PROJECTS */

.project-grid {
    display: grid;
    grid-template-columns: repeat(2,1fr);
    gap: 20px;
}

.project-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 28px;
}

.project-card > span {
    color: var(--primary);
    font-weight: 800;
}

.project-card h3 {
    font-family: "Manrope";
    margin: 12px 0 8px;
}

.project-card p {
    color: var(--muted);
    margin-bottom: 20px;
}

.project-card button {
    background: transparent;
    color: var(--primary);
    font-weight: 700;
}


/* HISTORY */

.history-item {
    display: flex;
    justify-content: space-between;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
}

.history-item strong {
    color: var(--green);
    font-size: 13px;
}


/* BADGES */

.badge-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 20px;
}

.badge-card {
    text-align: center;
    background: var(--card);
    border: 1px solid var(--border);
    padding: 30px 20px;
    border-radius: 18px;
}

.badge-card > div {
    font-size: 45px;
    margin-bottom: 15px;
}

.badge-card h3 {
    font-family: "Manrope";
}

.badge-card p {
    color: var(--muted);
    font-size: 12px;
    margin-top: 7px;
}

.locked-badge {
    opacity: .45;
}


/* LESSON MODAL */

.lesson-modal {
    position: fixed;
    inset: 0;
    background: rgba(2,8,23,.75);
    backdrop-filter: blur(8px);
    z-index: 3000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.lesson-modal.show {
    display: flex;
}

.lesson-window {
    width: min(950px,100%);
    max-height: 92vh;
    overflow-y: auto;
    background: var(--card);
    border-radius: 22px;
    padding: 30px;
    position: relative;
}

.close-btn {
    position: absolute;
    right: 20px;
    top: 18px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--bg);
    font-size: 22px;
}

.lesson-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-right: 45px;
    margin-bottom: 25px;
}

.lesson-header h2 {
    font-family: "Manrope";
    margin-top: 5px;
}

.lesson-progress {
    color: var(--primary);
    font-weight: 700;
}


/* TEACHER LESSON */

.teacher-lesson {
    display: flex;
    gap: 20px;
    padding: 20px;
    border-radius: 16px;
    background: #eff6ff;
    margin-bottom: 30px;
}

.teacher-image {
    min-width: 75px;
    height: 75px;
    background: white;
    border-radius: 18px;
    display: grid;
    place-items: center;
    font-size: 38px;
}

.teacher-speech strong {
    color: var(--primary);
}

.teacher-speech p {
    margin: 7px 0 12px;
    line-height: 1.6;
}

.teaching-controls {
    display: flex;
    gap: 7px;
}

.teaching-controls button {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: white;
}


/* LESSON CONTENT */

.lesson-content {
    line-height: 1.7;
}

.lesson-content h2 {
    font-family: "Manrope";
    margin-bottom: 10px;
}

.lesson-content h3 {
    margin: 25px 0 8px;
}

.lesson-content p {
    color: var(--muted);
    margin-bottom: 10px;
}

.code-example {
    background: #07111f;
    color: #dbeafe;
    padding: 20px;
    border-radius: 12px;
    margin: 20px 0;
    overflow-x: auto;
}

.code-example pre {
    font-family: monospace;
}

.lesson-content ul {
    padding-left: 20px;
}

.tip-box {
    background: #f0fdf4;
    border-left: 4px solid var(--green);
    padding: 15px;
    margin: 25px 0;
}


/* QUIZ */

.quiz {
    margin-top: 30px;
    padding: 22px;
    background: var(--bg);
    border-radius: 15px;
}

.quiz h3 {
    margin: 7px 0 15px;
}

.quiz button {
    display: block;
    width: 100%;
    text-align: left;
    background: var(--card);
    border: 1px solid var(--border);
    padding: 12px;
    margin: 8px 0;
    border-radius: 8px;
}

.quiz button:hover {
    border-color: var(--primary);
}

#quizResult {
    font-weight: 700;
    margin-top: 10px;
}

.lesson-navigation {
    display: flex;
    justify-content: space-between;
    margin-top: 30px;
}


/* DARK MODE */

body.dark {
    --bg: #07111f;
    --card: #0d1929;
    --text: #f8fafc;
    --muted: #94a3b8;
    --border: #1e293b;
    --sidebar: #020817;
}

body.dark .path-number,
body.dark .teacher-image,
body.dark .teaching-controls button {
    background: #111c2d;
}

body.dark .tip-box {
    background: #082116;
}

body.dark .teacher-lesson {
    background: #0c2341;
}


/* MOBILE */

@media (max-width: 1000px) {

    .stats-grid {
        grid-template-columns: repeat(2,1fr);
    }

    .course-grid {
        grid-template-columns: 1fr 1fr;
    }

    .badge-grid {
        grid-template-columns: repeat(2,1fr);
    }
}


@media (max-width: 750px) {

    .sidebar {
        transform: translateX(-100%);
        transition: .3s;
    }

    .sidebar.open {
        transform: translateX(0);
    }

    .main {
        margin-left: 0;
    }

    .menu-btn {
        display: block;
    }

    .topbar {
        padding: 0 18px;
        gap: 15px;
    }

    .top-title {
        margin-right: auto;
    }

    .profile-info {
        display: none;
    }

    .page {
        padding: 20px 15px;
    }

    .welcome-card {
        padding: 25px;
    }

    .welcome-code {
        display: none;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .course-grid,
    .project-grid {
        grid-template-columns: 1fr;
    }

    .badge-grid {
        grid-template-columns: 1fr 1fr;
    }

    .lesson-row {
        flex-wrap: wrap;
    }

    .lesson-info {
        min-width: 70%;
    }

    .lesson-window {
        padding: 20px;
    }

}


@media (max-width: 500px) {

    .stats-grid {
        grid-template-columns: 1fr 1fr;
    }

    .stat-card {
        padding: 14px;
    }

    .stat-icon {
        display: none;
    }

    .welcome-card h2 {
        font-size: 25px;
    }

    .top-title h1 {
        font-size: 17px;
    }

    .teacher-lesson {
        flex-direction: column;
    }

    .teacher-image {
        width: 65px;
    }

}
/* =========================
   AUTHENTICATION SCREEN
========================= */

.auth-screen {
    position: fixed;
    inset: 0;
    z-index: 99999;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;

    background:
        linear-gradient(
            135deg,
            #071b35,
            #123f78,
            #071b35
        );

    overflow-y: auto;
}


.auth-card {
    width: 100%;
    max-width: 430px;

    background: rgba(255,255,255,0.97);

    border-radius: 24px;

    padding: 32px;

    box-shadow:
        0 25px 70px rgba(0,0,0,0.35);
}


.auth-logo {
    text-align: center;
    margin-bottom: 25px;
}


.auth-logo-icon {
    width: 58px;
    height: 58px;

    margin: 0 auto 12px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 17px;

    background: #2563eb;

    color: white;

    font-size: 25px;
    font-weight: 800;
}


.auth-logo h1 {
    margin: 0;

    font-size: 24px;

    color: #111827;
}


.auth-card h2 {
    margin-bottom: 8px;

    color: #111827;
}


.auth-subtitle {
    margin-top: 0;
    margin-bottom: 22px;

    color: #6b7280;

    line-height: 1.5;
}


.auth-card label {
    display: block;

    margin-top: 15px;
    margin-bottom: 7px;

    font-weight: 600;

    color: #374151;
}


.auth-card input {
    width: 100%;

    box-sizing: border-box;

    padding: 14px 15px;

    border: 1px solid #d1d5db;

    border-radius: 12px;

    outline: none;

    font-size: 15px;

    background: white;

    color: #111827;
}


.auth-card input:focus {
    border-color: #2563eb;

    box-shadow:
        0 0 0 3px rgba(37,99,235,0.12);
}


.auth-button {
    width: 100%;

    margin-top: 22px;

    padding: 15px;

    border: none;

    border-radius: 12px;

    background: #2563eb;

    color: white;

    font-size: 16px;

    font-weight: 700;

    cursor: pointer;
}


.auth-button:active {
    transform: scale(0.98);
}


.auth-button:disabled {
    opacity: 0.6;

    cursor: not-allowed;
}


.auth-switch {
    margin-top: 20px;

    text-align: center;

    color: #6b7280;
}


.text-button {
    border: none;

    background: none;

    color: #2563eb;

    font-weight: 700;

    cursor: pointer;

    font-size: inherit;
}


.auth-message {
    min-height: 20px;

    margin-top: 12px;

    text-align: center;

    font-size: 14px;

    font-weight: 600;
}


/* DARK MODE */

body.dark .auth-card {
    background: #111827;
}


body.dark .auth-logo h1,
body.dark .auth-card h2 {
    color: #f9fafb;
}


body.dark .auth-subtitle,
body.dark .auth-switch {
    color: #9ca3af;
}


body.dark .auth-card label {
    color: #d1d5db;
}


body.dark .auth-card input {
    background: #1f2937;

    color: white;

    border-color: #374151;
}


/* MOBILE */

@media (max-width: 480px) {

    .auth-screen {
        padding: 15px;
    }

    .auth-card {
        padding: 25px 20px;

        border-radius: 20px;
    }

}
